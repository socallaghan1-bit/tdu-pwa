      <trkpt lat="-35.221000" lon="138.544000"><name>McLaren Vale Primary Feed Zone</name></trkpt>
      <trkpt lat="-35.281000" lon="138.448000"><name>Snapper Point Sprint (Aldinga)</name></trkpt>
      <trkpt lat="-35.280000" lon="138.580000"><name>Willunga Hill KOM (Cat 1)</name></trkpt>
    </trkseg>
