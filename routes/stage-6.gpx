      <trkpt lat="-34.819000" lon="138.956000"><name>Birdwood Motor Museum Sprint</name></trkpt>
      <trkpt lat="-35.012000" lon="138.722000"><name>Stirling Climb &amp; Finish Hub</name></trkpt>
