      <trkpt lat="-34.887000" lon="138.743000"><name>Corkscrew Road KOM (Cat 1)</name></trkpt>
      <trkpt lat="-34.877000" lon="138.711000"><name>Foxfield Oval Campbelltown Finish</name></trkpt>
    </trkseg>
  </trk>
</gpx>
